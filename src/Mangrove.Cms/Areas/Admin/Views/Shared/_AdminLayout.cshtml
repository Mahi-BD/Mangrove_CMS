@inject SettingsService Settings
@{
    var siteTitle = await Settings.GetAsync(SettingKeys.SiteTitle);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var type = Context.Request.Query["type"].ToString();
    // Views set ViewData["PostType"] / ViewData["TermType"]; the layout renders after the view.
    var navKey = controller switch
    {
        "Posts" => (ViewData["PostType"] as string ?? type) == "Page" ? "Pages" : "Posts",
        "Terms" => (ViewData["TermType"] as string ?? type) == "Tag" ? "Tags" : "Categories",
        _ => controller,
    };
    string Active(string key) => navKey == key ? "active" : "";
    var flash = TempData["Flash"] as string;
    var flashKind = TempData["FlashKind"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] ‹ @siteTitle — Mangrove</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <aside class="admin-nav">
        <a class="admin-brand" href="/admin"><img src="/favicon.svg" alt="" width="28" height="28" /> Mangrove</a>
        <nav aria-label="Admin">
            <a class="@Active("Dashboard")" href="/admin">Dashboard</a>
            <div class="nav-group">Content</div>
            <a class="@Active("Posts")" href="/admin/posts">Posts</a>
            @if (User.AtLeast(UserRole.Editor))
            {
                <a class="@Active("Pages")" href="/admin/posts?type=Page">Pages</a>
                <a class="@Active("Categories")" href="/admin/terms?type=Category">Categories</a>
                <a class="@Active("Tags")" href="/admin/terms?type=Tag">Tags</a>
            }
            <a class="@Active("Media")" href="/admin/media">Media</a>
            @if (User.AtLeast(UserRole.Editor))
            {
                <a class="@Active("Comments")" href="/admin/comments">Comments</a>
                <div class="nav-group">Appearance</div>
                <a class="@Active("Menus")" href="/admin/menus">Menus</a>
            }
            @if (User.AtLeast(UserRole.Administrator))
            {
                <a class="@Active("Themes")" href="/admin/themes">Themes</a>
                <div class="nav-group">System</div>
                <a class="@Active("Users")" href="/admin/users">Users</a>
                <a class="@Active("Settings")" href="/admin/settings">Settings</a>
            }
        </nav>
    </aside>
    <div class="admin-main">
        <header class="admin-top">
            <label for="nav-toggle" class="nav-burger" aria-label="Menu">☰</label>
            <a href="/" target="_blank" rel="noopener" class="view-site">@siteTitle ↗</a>
            <div class="spacer"></div>
            <a href="/account/profile">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value)</a>
            <form method="post" asp-antiforgery="true" action="/account/logout" class="inline">
                <button type="submit" class="linklike">Log out</button>
            </form>
        </header>
        <main class="admin-content">
            @if (!string.IsNullOrEmpty(flash))
            {
                <div class="flash flash-@flashKind" role="status">@flash</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
