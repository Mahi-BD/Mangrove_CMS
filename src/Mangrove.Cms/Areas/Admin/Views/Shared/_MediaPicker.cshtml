<dialog id="media-picker" class="media-picker">
    <form method="dialog" class="picker-head">
        <h2>Media library</h2>
        <input type="search" placeholder="Search files…" data-picker-search aria-label="Search media" />
        <label class="btn">Upload<input type="file" multiple hidden data-picker-upload accept="@MediaService.AcceptList" /></label>
        <button class="btn" value="cancel">Close</button>
    </form>
    <p class="muted picker-status" data-picker-status></p>
    <div class="picker-grid" data-picker-grid></div>
</dialog>
