@model PagedResult<Media>
@{ ViewData["Title"] = "Media"; var q = ViewBag.Q as string; Func<int, string> pageUrl = n => $"/admin/media?page={n}{(string.IsNullOrEmpty(q) ? "" : "&q=" + Uri.EscapeDataString(q))}"; }
<div class="page-head">
    <h1>Media</h1>
    <form method="get" class="search head-actions" role="search">
        <svg class="ic"><use href="#i-search" /></svg>
        <input type="search" name="q" value="@q" placeholder="Search by file name" aria-label="Search media" />
    </form>
</div>

<form method="post" asp-antiforgery="true" action="/admin/media/upload" enctype="multipart/form-data" class="dropzone" data-dropzone>
    <svg class="ic"><use href="#i-upload" /></svg>
    <div class="grow">
        <p><strong>Drop files here to upload</strong></p>
        <p class="small muted">Images, PDFs, Office documents, audio and video, up to @(MediaService.MaxBytes / 1024 / 1024) MB each.</p>
    </div>
    <label class="btn primary">Choose files<input type="file" name="files" multiple hidden accept="@MediaService.AcceptList" onchange="this.form.submit()" /></label>
</form>

@if (Model.Items.Count == 0)
{
    <p class="empty-state">@(string.IsNullOrEmpty(q) ? "Your media library is empty. Uploaded images and files will appear here." : $"No files match “{q}”.")</p>
}
<div class="media-grid">
    @foreach (var m in Model.Items)
    {
        <details class="media-item">
            <summary>
                @if (m.IsImage) { <img src="@m.Url" alt="@m.AltText" loading="lazy" /> }
                else { <span class="file-icon">@System.IO.Path.GetExtension(m.FileName).TrimStart('.').ToUpperInvariant()</span> }
                <span class="media-name" title="@m.FileName">@m.FileName</span>
            </summary>
            <div class="media-detail">
                <h2 style="margin-bottom:.2rem">@m.FileName</h2>
                <p class="small muted">@Fmt.Size(m.SizeBytes), uploaded @Fmt.Ago(m.UploadedAt)</p>
                <label for="url-@m.Id">File address</label>
                <input id="url-@m.Id" readonly value="@m.Url" onclick="this.select()" />
                <form method="post" asp-antiforgery="true" action="/admin/media/update/@m.Uid">
                    <label for="alt-@m.Id">Alt text</label>
                    <input id="alt-@m.Id" name="altText" value="@m.AltText" />
                    <span class="hint">Describes the image for people using screen readers.</span>
                    <label for="cap-@m.Id">Caption</label>
                    <input id="cap-@m.Id" name="caption" value="@m.Caption" />
                    <div class="actions">
                        <button class="btn">Save details</button>
                        <a class="btn quiet" href="@m.Url" target="_blank">Open file</a>
                        <span class="spacer"></span>
                        <button class="btn quiet danger" formaction="/admin/media/delete/@m.Uid" data-confirm-click="Delete @m.FileName? Posts that use it will show a broken image.">Delete</button>
                    </div>
                </form>
            </div>
        </details>
    }
</div>
<partial name="_Pager" model="(Model.Page, Model.TotalPages, pageUrl)" />
