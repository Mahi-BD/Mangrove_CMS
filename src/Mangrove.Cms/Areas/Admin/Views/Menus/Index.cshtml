@using Mangrove.Cms.Services
@{
    ViewData["Title"] = "Menus";
    var location = (string)ViewBag.Location;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    var names = new Dictionary<string, string> { ["primary"] = "Main menu", ["footer"] = "Footer menu" };
    var where = new Dictionary<string, string> { ["primary"] = "at the top of every page", ["footer"] = "at the bottom of every page" };
    var sources = new (string Key, string Label, string Type, object Items, string Empty)[]
    {
        ("pages", "Pages", MenuLinkTypes.Page, ViewBag.Pages, "No published pages yet."),
        ("posts", "Posts", MenuLinkTypes.Post, ViewBag.Posts, "No published posts yet."),
        ("categories", "Categories", MenuLinkTypes.Category, ViewBag.Categories, "No categories yet."),
        ("tags", "Tags", MenuLinkTypes.Tag, ViewBag.Tags, "No tags yet."),
    };
    var data = new
    {
        location,
        maxDepth = MenuService.MaxDepth,
        items = (List<MenuEditItem>)ViewBag.Items,
        sources = sources.ToDictionary(s => s.Type, s => s.Items),
    };
}
<div class="page-head">
    <h1>Menus</h1>
    <p class="lede">Add pages, posts, categories or links, then drag them into order. Drop an item under another one to make it a sub-item; it then opens from its parent as a dropdown.</p>
</div>

<div class="toolbar">
    <nav class="filters" aria-label="Choose a menu">
        @foreach (var loc in MenuService.Locations)
        {
            <a class="@(loc == location ? "active" : null)" href="/admin/menus?location=@loc">@names[loc]<span class="n">@(counts.TryGetValue(loc, out var n) ? n : 0)</span></a>
        }
    </nav>
</div>

<div class="grid-side menu-builder" id="menu-builder">
    <aside class="mb-sources">
        <h2 class="mb-side-title">Add menu items</h2>
        @foreach (var (s, i) in sources.Select((s, i) => (s, i)))
        {
            var list = ((System.Collections.IEnumerable)s.Items).Cast<object>().ToList();
            <details class="panel mb-source" open="@(i == 0)" data-source="@s.Type">
                <summary>@s.Label <span class="muted small">@list.Count</span></summary>
                @if (list.Count == 0)
                {
                    <p class="muted small">@s.Empty</p>
                }
                else
                {
                    @if (list.Count > 8)
                    {
                        <input type="search" class="mb-filter" placeholder="Search @s.Label.ToLowerInvariant()" aria-label="Search @s.Label.ToLowerInvariant()" data-source-filter />
                    }
                    <div class="mb-checklist" data-checklist></div>
                    <div class="mb-source-actions">
                        <button type="button" class="linklike small" data-select-all>Select all</button>
                        <button type="button" class="btn sm" data-add-selected>Add to menu</button>
                    </div>
                }
            </details>
        }
        <details class="panel mb-source" data-source="custom">
            <summary>Custom link</summary>
            <label for="mb-url">Link</label>
            <input id="mb-url" placeholder="https://example.com or /contact" data-custom-url />
            <label for="mb-label">Label</label>
            <input id="mb-label" placeholder="Shown in the menu" data-custom-label />
            <p class="field-error" data-custom-error></p>
            <div class="mb-source-actions"><span></span><button type="button" class="btn sm" data-add-custom>Add to menu</button></div>
        </details>
    </aside>

    <section class="panel mb-structure">
        <div class="mb-structure-head">
            <div>
                <h2>@names[location]</h2>
                <p class="muted small">Shown @where[location].</p>
            </div>
            <span class="spacer"></span>
            <span class="small" data-state aria-live="polite"></span>
            <button type="button" class="btn primary" data-save>Save menu</button>
        </div>
        <ul class="mb-list" data-list aria-label="Menu structure"></ul>
        <div class="mb-empty" data-empty hidden>
            <svg class="ic"><use href="#i-menus" /></svg>
            <p>This menu is empty. Tick pages or categories on the left and click <strong>Add to menu</strong>.</p>
        </div>
        <p class="hint mb-hint">Drag an item by its dots to reorder it. To make a sub-item, drop it into the space under another item. Open an item to rename it or use the move buttons.</p>
    </section>
</div>

@section Scripts {
    <script>window.MANGROVE_MENU = @Json.Serialize(data);</script>
    <script src="/lib/sortablejs/Sortable.min.js" asp-append-version="true"></script>
    <script src="/js/menu-editor.js" asp-append-version="true"></script>
}
