@model List<Term>
@{
    var type = (TermType)ViewBag.Type;
    var counts = (Dictionary<int, int>)ViewBag.Counts;
    var editing = ViewBag.Editing as Term;
    var label = type == TermType.Category ? "Categories" : "Tags";
    var noun = type == TermType.Category ? "category" : "tag";
    ViewData["Title"] = label;
    ViewData["TermType"] = type.ToString();
}
<div class="page-head"><h1>@label</h1></div>
<div class="grid-side">
    <section class="panel">
        <h2>@(editing == null ? $"Add new {noun}" : $"Edit {noun}")</h2>
        <form method="post" asp-antiforgery="true" action="/admin/terms/save" class="stack">
            <input type="hidden" name="id" value="@(editing?.Id ?? 0)" />
            <input type="hidden" name="type" value="@type" />
            <label>Name <input name="name" value="@editing?.Name" required maxlength="120" /></label>
            <label>Slug <input name="slug" value="@editing?.Slug" placeholder="auto" maxlength="140" /></label>
            @if (type == TermType.Category)
            {
                <label>Parent
                    <select name="parentId">
                        <option value="">None</option>
                        @foreach (var t in Model.Where(t => t.Id != editing?.Id))
                        {
                            <option value="@t.Id" selected="@(editing?.ParentId == t.Id)">@t.Name</option>
                        }
                    </select>
                </label>
            }
            <label>Description <textarea name="description" rows="3" maxlength="500">@editing?.Description</textarea></label>
            <div class="actions">
                <button class="btn primary">@(editing == null ? $"Add {noun}" : "Save")</button>
                @if (editing != null) { <a class="btn" href="/admin/terms?type=@type">Cancel</a> }
            </div>
        </form>
    </section>
    <div class="table-wrap">
    <table class="table">
        <thead><tr><th>Name</th><th>Slug</th><th>Posts</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0) { <tr><td colspan="4" class="muted">None yet.</td></tr> }
            @foreach (var t in Model)
            {
                <tr>
                    <td><a class="row-title" href="/admin/terms?type=@type&edit=@t.Id">@t.Name</a>
                        @if (!string.IsNullOrEmpty(t.Description)) { <div class="small muted">@t.Description</div> }
                    </td>
                    <td><a href="/@(type == TermType.Category ? "category" : "tag")/@t.Slug" target="_blank">@t.Slug</a></td>
                    <td>@(counts.TryGetValue(t.Id, out var n) ? n : 0)</td>
                    <td class="right">
                        <form method="post" asp-antiforgery="true" action="/admin/terms/delete/@t.Id" class="inline" data-confirm="Delete “@t.Name”? Posts keep existing, just without it.">
                            <button class="linklike danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
