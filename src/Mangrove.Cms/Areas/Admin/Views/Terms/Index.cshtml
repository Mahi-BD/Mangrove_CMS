@model List<Term>
@{
    var type = (TermType)ViewBag.Type;
    var counts = (Dictionary<int, int>)ViewBag.Counts;
    var editing = ViewBag.Editing as Term;
    var isCat = type == TermType.Category;
    var label = isCat ? "Categories" : "Tags";
    var noun = isCat ? "category" : "tag";
    ViewData["Title"] = label;
    ViewData["TermType"] = type.ToString();
}
<div class="page-head">
    <h1>@label</h1>
    <p class="lede">@(isCat ? "Categories group posts into broad sections, like Travel or News. Every post belongs to at least one." : "Tags describe the details of a post. Add them while writing; they appear here automatically.")</p>
</div>
<div class="grid-side">
    <section class="panel">
        <h2>@(editing == null ? $"Add a {noun}" : $"Edit “{editing.Name}”")</h2>
        <form method="post" asp-antiforgery="true" action="/admin/terms/save">
            <input type="hidden" name="id" value="@(editing?.Id ?? 0)" />
            <input type="hidden" name="type" value="@type" />
            <label for="t-name">Name</label>
            <input id="t-name" name="name" value="@editing?.Name" required maxlength="120" />
            <label for="t-slug">Web address</label>
            <input id="t-slug" name="slug" value="@editing?.Slug" placeholder="made-from-the-name" maxlength="140" />
            @if (isCat)
            {
                <label for="t-parent">Parent category</label>
                <select id="t-parent" name="parentId">
                    <option value="">None</option>
                    @foreach (var t in Model.Where(t => t.Id != editing?.Id))
                    {
                        <option value="@t.Id" selected="@(editing?.ParentId == t.Id)">@t.Name</option>
                    }
                </select>
            }
            <label for="t-desc">Description</label>
            <textarea id="t-desc" name="description" rows="3" maxlength="500">@editing?.Description</textarea>
            <span class="hint">Some themes show this at the top of the @noun's page.</span>
            <div class="actions">
                <button class="btn primary">@(editing == null ? $"Add {noun}" : "Save changes")</button>
                @if (editing != null) { <a class="btn quiet" href="/admin/terms?type=@type">Cancel</a> }
            </div>
        </form>
    </section>
    <div class="table-wrap">
    <table class="table">
        <thead><tr><th>Name</th><th>Web address</th><th class="right">Posts</th></tr></thead>
        <tbody>
            @if (Model.Count == 0) { <tr class="empty"><td colspan="3">No @label.ToLowerInvariant() yet.</td></tr> }
            @foreach (var t in Model)
            {
                <tr>
                    <td>
                        <a class="row-title" href="/admin/terms?type=@type&edit=@t.Id">@t.Name</a>
                        @if (!string.IsNullOrEmpty(t.Description)) { <div class="small muted">@t.Description</div> }
                        <div class="row-actions">
                            <a href="/admin/terms?type=@type&edit=@t.Id">Edit</a>
                            <a href="/@(isCat ? "category" : "tag")/@t.Slug" target="_blank">View</a>
                            <form method="post" asp-antiforgery="true" action="/admin/terms/delete/@t.Id" class="inline" data-confirm="Delete “@t.Name”? Posts stay; they just lose this @noun.">
                                <button class="linklike danger">Delete</button>
                            </form>
                        </div>
                    </td>
                    <td class="muted">/@(isCat ? "category" : "tag")/@t.Slug</td>
                    <td class="right num">@(counts.TryGetValue(t.Id, out var n) ? n : 0)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
