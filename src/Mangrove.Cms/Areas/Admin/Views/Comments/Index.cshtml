@model PagedResult<Comment>
@{
    ViewData["Title"] = "Comments";
    var status = ViewBag.Status as CommentStatus?;
    var counts = (Dictionary<CommentStatus, int>)ViewBag.Counts;
    int Count(CommentStatus s) => counts.TryGetValue(s, out var c) ? c : 0;
    Func<int, string> pageUrl = n => $"/admin/comments?page={n}{(status.HasValue ? "&status=" + status : "")}";
    var tabs = new (CommentStatus? S, string Label, int N)[]
    {
        (null, "All", Count(CommentStatus.Pending) + Count(CommentStatus.Approved)),
        (CommentStatus.Pending, "Pending", Count(CommentStatus.Pending)),
        (CommentStatus.Approved, "Approved", Count(CommentStatus.Approved)),
        (CommentStatus.Spam, "Spam", Count(CommentStatus.Spam)),
        (CommentStatus.Trash, "Trash", Count(CommentStatus.Trash)),
    };
}
<div class="page-head"><h1>Comments</h1></div>
<div class="toolbar">
    <nav class="filters" aria-label="Filter by status">
        @foreach (var t in tabs)
        {
            <a class="@(status == t.S ? "active" : null)" href="/admin/comments@(t.S.HasValue ? "?status=" + t.S : "")">@t.Label<span class="n">@t.N</span></a>
        }
    </nav>
</div>

<div class="table-wrap">
<table class="table">
    <thead><tr><th style="width:22%">From</th><th>Comment</th><th style="width:20%">On</th><th>Received</th></tr></thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr class="empty"><td colspan="4">@(status == CommentStatus.Pending ? "Nothing to review. New comments that need approval appear here." : "No comments here.")</td></tr>
        }
        @foreach (var c in Model.Items)
        {
            <tr class="@(c.Status == CommentStatus.Pending ? "pending" : null)">
                <td>
                    <strong>@c.AuthorName</strong>
                    @if (!string.IsNullOrEmpty(c.AuthorEmail)) { <div class="small muted">@c.AuthorEmail</div> }
                    @if (c.Status == CommentStatus.Pending) { <span class="status status-pending">Pending</span> }
                </td>
                <td>
                    <div class="comment-text">@c.Content</div>
                    <div class="row-actions" style="visibility:visible">
                        @foreach (var target in new[] { CommentStatus.Approved, CommentStatus.Pending, CommentStatus.Spam, CommentStatus.Trash }.Where(s => s != c.Status))
                        {
                            var verb = target switch { CommentStatus.Approved => "Approve", CommentStatus.Pending => "Unapprove", CommentStatus.Spam => "Spam", _ => "Trash" };
                            <form method="post" asp-antiforgery="true" action="/admin/comments/setstatus/@c.Id" class="inline">
                                <input type="hidden" name="status" value="@target" />
                                <input type="hidden" name="from" value="@status" />
                                <button class="linklike @(target is CommentStatus.Spam or CommentStatus.Trash ? "danger" : null)">@verb</button>
                            </form>
                        }
                        @if (c.Status is CommentStatus.Spam or CommentStatus.Trash)
                        {
                            <form method="post" asp-antiforgery="true" action="/admin/comments/delete/@c.Id" class="inline" data-confirm="Delete this comment for good?">
                                <input type="hidden" name="from" value="@status" />
                                <button class="linklike danger">Delete for good</button>
                            </form>
                        }
                    </div>
                </td>
                <td><a href="/@c.Post?.Slug#comment-@c.Id" target="_blank">@c.Post?.Title</a></td>
                <td class="when">@Fmt.Ago(c.CreatedAt)</td>
            </tr>
        }
    </tbody>
</table>
</div>
<partial name="_Pager" model="(Model.Page, Model.TotalPages, pageUrl)" />
