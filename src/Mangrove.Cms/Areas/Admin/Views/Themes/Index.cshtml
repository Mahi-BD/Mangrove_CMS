@model IReadOnlyList<ThemeInfo>
@{ ViewData["Title"] = "Themes"; var active = (string)ViewBag.Active; }
<div class="page-head">
    <h1>Themes</h1>
    <p class="lede">A theme decides how your public site looks. Your content stays the same when you switch.</p>
</div>
<div class="theme-grid">
    @foreach (var t in Model)
    {
        var isActive = string.Equals(t.Folder, active, StringComparison.OrdinalIgnoreCase);
        var swatch = t.Folder.ToLowerInvariant() is "mangrove" or "minimal" ? t.Folder.ToLowerInvariant() : "mangrove";
        <article class="panel theme-card @(isActive ? "active" : null)">
            <div class="swatch swatch-@swatch" aria-hidden="true">
                <div class="mock"><b>@t.Name</b><i style="width:90%"></i><i style="width:75%"></i><i style="width:82%"></i></div>
            </div>
            <div class="body">
                <h2>@t.Name @if (isActive) { <span class="status status-published" style="font-weight:500">Active</span> }</h2>
                <p class="muted">@t.Description</p>
                <p class="small muted">@t.Author@(string.IsNullOrEmpty(t.Version) ? "" : ", version " + t.Version)</p>
                @if (isActive)
                {
                    <a class="btn" href="/" target="_blank">View site <svg class="ic"><use href="#i-external" /></svg></a>
                }
                else
                {
                    <form method="post" asp-antiforgery="true" action="/admin/themes/activate">
                        <input type="hidden" name="folder" value="@t.Folder" />
                        <button class="btn primary">Use this theme</button>
                    </form>
                }
            </div>
        </article>
    }
</div>
<p class="small muted" style="margin-top:1.5rem">To build your own theme, copy <code>Themes/Minimal</code> and change only the views you need. Anything you leave out comes from Mangrove.</p>
