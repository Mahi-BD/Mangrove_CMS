@model UserEditForm
@{ ViewData["Title"] = Model.Id == 0 ? "Add user" : "Edit user"; }
<div class="page-head"><h1>@ViewData["Title"]</h1></div>
<form method="post" asp-antiforgery="true" action="/admin/users/save" class="panel stack narrow-form">
    <div asp-validation-summary="ModelOnly" class="errors"></div>
    <input type="hidden" asp-for="Id" />
    <label asp-for="UserName">Username</label>
    <input asp-for="UserName" autocomplete="off" />
    <span asp-validation-for="UserName" class="field-error"></span>
    <label asp-for="Email"></label>
    <input asp-for="Email" autocomplete="off" />
    <span asp-validation-for="Email" class="field-error"></span>
    <label asp-for="DisplayName"></label>
    <input asp-for="DisplayName" />
    <label asp-for="Role"></label>
    <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>().Reverse()"></select>
    <span asp-validation-for="Role" class="field-error"></span>
    <small class="muted">Subscriber: profile only · Author: own posts · Editor: all content · Administrator: everything</small>
    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="new-password" />
    <span asp-validation-for="Password" class="field-error"></span>
    <label class="check"><input asp-for="IsActive" /> Account active</label>
    <div class="actions">
        <button class="btn primary">@(Model.Id == 0 ? "Create user" : "Save user")</button>
        <a class="btn" href="/admin/users">Cancel</a>
    </div>
</form>
