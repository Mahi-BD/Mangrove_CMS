@model PostEditForm
@{
    var isPage = Model.Type == PostType.Page;
    var kind = isPage ? Model.Kind : PageKind.Standard;
    var noun = kind switch { PageKind.Table => "table page", PageKind.Notices => "notice board", _ => isPage ? "page" : "post" };
    ViewData["Title"] = Model.Id == 0 ? $"New {noun}" : $"Edit {noun}";
    ViewData["PostType"] = Model.Type.ToString();
    var categories = (List<Term>)ViewBag.Categories;
    var pages = (List<Post>)ViewBag.Pages;
    var featured = ViewBag.Featured as Media;
    var isLive = Model.Id != 0 && Model.Status == PostStatus.Published;
    var listNoun = kind == PageKind.Table ? "rows" : "notices";
    var sizes = new[] { 10, 25, 50, 100 };
}
<div class="page-head">
    <h1>@ViewData["Title"]</h1>
    @if (Model.Id != 0)
    {
        <span class="status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
        <div class="head-actions">
            <a class="btn" href="/@Model.Slug" target="_blank">@(isLive ? "View" : "Preview") <svg class="ic"><use href="#i-external" /></svg></a>
        </div>
    }
</div>

<form method="post" asp-antiforgery="true" action="/admin/posts/save" class="editor-grid" id="post-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="Kind" />
    <div asp-validation-summary="All" class="errors"></div>

    <div class="editor-main">
        @if (kind == PageKind.Standard)
        {
            <div class="sheet md-editor" data-preview-url="/admin/posts/preview">
                <partial name="_TitleFields" model="Model" />
                <div class="md-toolbar" role="toolbar" aria-label="Formatting">
                    <button type="button" data-md="bold" title="Bold (Ctrl+B)"><b>B</b></button>
                    <button type="button" data-md="italic" title="Italic (Ctrl+I)"><i>I</i></button>
                    <button type="button" data-md="link" title="Link (Ctrl+K)">Link</button>
                    <span class="sep"></span>
                    <button type="button" data-md="h2" title="Heading">H2</button>
                    <button type="button" data-md="h3" title="Subheading">H3</button>
                    <button type="button" data-md="quote" title="Quote">Quote</button>
                    <button type="button" data-md="ul" title="Bulleted list">List</button>
                    <button type="button" data-md="ol" title="Numbered list">1. 2. 3.</button>
                    <button type="button" data-md="code" title="Code">Code</button>
                    <span class="sep"></span>
                    <button type="button" data-md="image" title="Upload or choose an image" class="tb-strong"><svg class="ic"><use href="#i-media" /></svg> Add image</button>
                    <span class="spacer"></span>
                    <span class="seg">
                        <button type="button" class="tab active" data-tab="write">Write</button>
                        <button type="button" class="tab" data-tab="preview">Preview</button>
                    </span>
                </div>
                <label for="Content" class="sr-only">Content</label>
                <textarea asp-for="Content" rows="22" class="md-input" placeholder="Start writing. Markdown works: **bold**, ## heading, - list. Use Add image, or paste or drop pictures here."></textarea>
                <div class="md-preview entry-content" hidden></div>
            </div>
        }
        else
        {
            <div class="sheet sheet-head">
                <partial name="_TitleFields" model="Model" />
            </div>

            @if (kind == PageKind.Table)
            {
                <input type="hidden" asp-for="TableJson" id="table-json" />
                <partial name="_TableEditor" />
            }
            else
            {
                <input type="hidden" asp-for="NoticesJson" id="notices-json" />
                <partial name="_NoticeEditor" />
            }

            <details class="panel" open="@(!string.IsNullOrWhiteSpace(Model.Content))">
                <summary>Introduction text (optional)</summary>
                <label for="Content" class="sr-only">Introduction text</label>
                <textarea asp-for="Content" rows="4" class="intro-input" placeholder="A short paragraph shown above the @(kind == PageKind.Table ? "table" : "notices"). Markdown works."></textarea>
            </details>
        }

        <details class="panel" open="@(!string.IsNullOrEmpty(Model.Excerpt) || !string.IsNullOrEmpty(Model.MetaDescription))">
            <summary>Summary and search appearance</summary>
            <label asp-for="Excerpt">Summary</label>
            <textarea asp-for="Excerpt" rows="3"></textarea>
            <span class="hint">Shown in post lists and feeds. If left empty, the opening lines are used.</span>
            <label asp-for="MetaDescription">Search description</label>
            <input asp-for="MetaDescription" maxlength="300" />
            <span class="hint">What search engines show under the title. About 155 characters works best.</span>
        </details>
    </div>

    <div class="editor-side">
        <section class="panel">
            <h2>Publishing</h2>
            <label asp-for="Status">Status</label>
            <select asp-for="Status" id="status-select">
                <option value="Draft">Draft</option>
                <option value="Published">Published</option>
                <option value="Scheduled">Scheduled</option>
            </select>
            <label asp-for="PublishedAt">Publish date (UTC)</label>
            <input asp-for="PublishedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
            <span asp-validation-for="PublishedAt" class="field-error"></span>
            <span class="hint">Leave empty to publish now. Pick a future date with “Scheduled”.</span>
            @if (kind == PageKind.Standard)
            {
                <label class="check" style="margin-top:.9rem"><input asp-for="AllowComments" /> Allow comments</label>
            }
            @if (!isPage && User.AtLeast(UserRole.Editor))
            {
                <label class="check"><input asp-for="IsSticky" /> Pin to the top of the blog</label>
            }
            <div class="publish-actions">
                @if (!isLive) { <button type="submit" class="btn" data-status="Draft">Save draft</button> }
                <button type="submit" class="btn primary" data-primary>@(isLive ? "Update" : "Save")</button>
            </div>
            <span class="hint save-hint" data-save-hint hidden>You have unsaved changes.</span>
            @if (Model.Id != 0)
            {
                <button type="submit" form="trash-form" class="linklike danger trash-link">Move to trash</button>
            }
        </section>

        @if (kind != PageKind.Standard)
        {
            <section class="panel">
                <h2>On the website</h2>
                <label asp-for="ListPageSize">@(kind == PageKind.Table ? "Rows" : "Notices")</label>
                <select asp-for="ListPageSize">
                    <option value="0">Show all @listNoun on one page</option>
                    @foreach (var n in sizes.Union(new[] { Model.ListPageSize }).Where(n => n > 0).OrderBy(n => n))
                    {
                        <option value="@n">@n @listNoun per page</option>
                    }
                </select>
                <label class="check" style="margin-top:.8rem"><input asp-for="ListSearchable" /> Show a search box</label>
            </section>
        }

        @if (!isPage)
        {
            <section class="panel">
                <h2>Categories</h2>
                <div class="checklist">
                    @foreach (var c in categories)
                    {
                        <label class="check"><input type="checkbox" name="CategoryIds" value="@c.Id" checked="@Model.CategoryIds.Contains(c.Id)" /> @c.Name</label>
                    }
                </div>
                @if (User.AtLeast(UserRole.Editor))
                {
                    <a href="/admin/terms?type=Category" class="small">Manage categories</a>
                }
            </section>
            <section class="panel">
                <h2><label for="Tags" style="margin:0">Tags</label></h2>
                <input asp-for="Tags" placeholder="travel, food, rajshahi" />
                <span class="hint">Separate tags with commas.</span>
            </section>
        }
        else
        {
            <section class="panel">
                <h2>Page settings</h2>
                <label asp-for="ParentId">Parent page</label>
                <select asp-for="ParentId">
                    <option value="">None (top level)</option>
                    @foreach (var p in pages)
                    {
                        <option value="@p.Id">@p.Title</option>
                    }
                </select>
                <span asp-validation-for="ParentId" class="field-error"></span>
                <label asp-for="MenuOrder">Order</label>
                <input asp-for="MenuOrder" type="number" />
            </section>
        }

        <section class="panel">
            <h2>Featured image</h2>
            <input type="hidden" asp-for="FeaturedMediaId" id="featured-id" />
            <div id="featured-preview" class="featured-preview">
                @if (featured is { IsImage: true })
                {
                    <img src="@featured.Url" alt="" />
                }
            </div>
            <button type="button" class="btn sm" data-pick-featured>@(featured == null ? "Choose image" : "Replace image")</button>
            <button type="button" class="btn sm quiet danger" data-clear-featured hidden="@(featured == null)">Remove</button>
        </section>
    </div>
</form>

@if (Model.Id != 0)
{
    <form id="trash-form" method="post" asp-antiforgery="true" action="/admin/posts/trash/@Model.Id" data-confirm="Move this @noun to the trash? You can restore it later."></form>
}

<partial name="_MediaPicker" />

@section Scripts {
    <script>
        // "Save draft" always saves as a draft, whatever the dropdown says.
        var draftBtn = document.querySelector('[data-status="Draft"]');
        if (draftBtn) draftBtn.addEventListener('click', function () {
            document.getElementById('status-select').value = 'Draft';
        });
        // Name the primary button after what it will do.
        var sel = document.getElementById('status-select'), primary = document.querySelector('[data-primary]');
        var live = @(isLive ? "true" : "false");
        function label() {
            primary.textContent = sel.value === 'Published' ? (live ? 'Update' : 'Publish')
                                : sel.value === 'Scheduled' ? 'Schedule' : (live ? 'Update' : 'Save');
        }
        sel.addEventListener('change', label); label();
    </script>
    @if (kind == PageKind.Table)
    {
        <script>window.MANGROVE_TYPES = @Json.Serialize(Enum.GetValues<ColumnType>().Select(t => new { value = (int)t, label = TableService.ShortType(t), title = TableService.DisplayType(t) }));</script>
        <script src="/js/table-editor.js" asp-append-version="true"></script>
    }
    @if (kind == PageKind.Notices)
    {
        <script src="/js/notice-editor.js" asp-append-version="true"></script>
    }
}
