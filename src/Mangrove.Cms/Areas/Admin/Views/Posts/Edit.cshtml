@model PostEditForm
@{
    var isPage = Model.Type == PostType.Page;
    var noun = isPage ? "page" : "post";
    ViewData["Title"] = Model.Id == 0 ? $"Add new {noun}" : $"Edit {noun}";
    ViewData["PostType"] = Model.Type.ToString();
    var categories = (List<Term>)ViewBag.Categories;
    var pages = (List<Post>)ViewBag.Pages;
    var featured = ViewBag.Featured as Media;
}
<div class="page-head">
    <h1>@ViewData["Title"]</h1>
    @if (Model.Id != 0)
    {
        <a class="btn" href="/admin/posts/create?type=@Model.Type">Add new</a>
        <a class="btn" href="/@Model.Slug" target="_blank">@(Model.Status == PostStatus.Published ? "View" : "Preview") ↗</a>
    }
</div>

<form method="post" asp-antiforgery="true" action="/admin/posts/save" class="editor-grid" id="post-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Type" />
    <div asp-validation-summary="ModelOnly" class="errors"></div>

    <div class="editor-main">
        <input asp-for="Title" class="title-input" placeholder="Add title" autofocus="@(Model.Id == 0)" />
        <span asp-validation-for="Title" class="field-error"></span>
        <div class="slug-row">
            <span class="muted">Permalink: /</span>
            <input asp-for="Slug" placeholder="generated-from-title" aria-label="Slug" />
        </div>

        <div class="md-editor" data-preview-url="/admin/posts/preview">
            <div class="md-toolbar" role="toolbar" aria-label="Formatting">
                <button type="button" data-md="bold" title="Bold (Ctrl+B)"><b>B</b></button>
                <button type="button" data-md="italic" title="Italic (Ctrl+I)"><i>I</i></button>
                <button type="button" data-md="h2" title="Heading">H2</button>
                <button type="button" data-md="h3" title="Sub-heading">H3</button>
                <button type="button" data-md="link" title="Link (Ctrl+K)">Link</button>
                <button type="button" data-md="quote" title="Quote">❝</button>
                <button type="button" data-md="ul" title="Bulleted list">• List</button>
                <button type="button" data-md="ol" title="Numbered list">1. List</button>
                <button type="button" data-md="code" title="Code">&lt;/&gt;</button>
                <button type="button" data-md="image" title="Insert media">Media</button>
                <span class="spacer"></span>
                <button type="button" class="tab active" data-tab="write">Write</button>
                <button type="button" class="tab" data-tab="preview">Preview</button>
            </div>
            <textarea asp-for="Content" rows="22" class="md-input" placeholder="Start writing… Markdown and HTML both work."></textarea>
            <div class="md-preview entry-content" hidden></div>
        </div>

        <details class="panel" open="@(!string.IsNullOrEmpty(Model.Excerpt) || !string.IsNullOrEmpty(Model.MetaDescription))">
            <summary>Excerpt &amp; SEO</summary>
            <label asp-for="Excerpt"></label>
            <textarea asp-for="Excerpt" rows="3" placeholder="Optional summary shown in listings and feeds"></textarea>
            <label asp-for="MetaDescription"></label>
            <input asp-for="MetaDescription" placeholder="Shown by search engines (≈155 characters)" />
        </details>
    </div>

    <div class="editor-side">
        <section class="panel">
            <h2>Publish</h2>
            <label asp-for="Status"></label>
            <select asp-for="Status" id="status-select">
                <option value="Draft">Draft</option>
                <option value="Published">Published</option>
                <option value="Scheduled">Scheduled</option>
            </select>
            <label asp-for="PublishedAt"></label>
            <input asp-for="PublishedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
            <span asp-validation-for="PublishedAt" class="field-error"></span>
            <small class="muted">Leave empty to use “now” when publishing.</small>
            @if (!isPage)
            {
                <label class="check"><input asp-for="AllowComments" /> Allow comments</label>
                @if (User.AtLeast(UserRole.Editor))
                {
                    <label class="check"><input asp-for="IsSticky" /> Stick to the top</label>
                }
            }
            else
            {
                <label class="check"><input asp-for="AllowComments" /> Allow comments</label>
            }
            <div class="actions">
                <button type="submit" class="btn" name="saveDraft" value="1" data-status="Draft">Save draft</button>
                <button type="submit" class="btn primary">@(Model.Status == PostStatus.Published ? "Update" : "Save")</button>
            </div>
            @if (Model.Id != 0)
            {
                <button type="submit" form="trash-form" class="linklike danger">Move to trash</button>
            }
        </section>

        @if (!isPage)
        {
            <section class="panel">
                <h2>Categories</h2>
                <div class="checklist">
                    @foreach (var c in categories)
                    {
                        <label class="check"><input type="checkbox" name="CategoryIds" value="@c.Id" checked="@Model.CategoryIds.Contains(c.Id)" /> @c.Name</label>
                    }
                </div>
                @if (User.AtLeast(UserRole.Editor))
                {
                    <a href="/admin/terms?type=Category" class="small">Manage categories</a>
                }
            </section>
            <section class="panel">
                <h2>Tags</h2>
                <input asp-for="Tags" placeholder="news, release, tips" />
                <small class="muted">Separate tags with commas.</small>
            </section>
        }
        else
        {
            <section class="panel">
                <h2>Page attributes</h2>
                <label asp-for="ParentId"></label>
                <select asp-for="ParentId">
                    <option value="">(no parent)</option>
                    @foreach (var p in pages)
                    {
                        <option value="@p.Id">@p.Title</option>
                    }
                </select>
                <span asp-validation-for="ParentId" class="field-error"></span>
                <label asp-for="MenuOrder"></label>
                <input asp-for="MenuOrder" type="number" />
            </section>
        }

        <section class="panel">
            <h2>Featured image</h2>
            <input type="hidden" asp-for="FeaturedMediaId" id="featured-id" />
            <div id="featured-preview" class="featured-preview">
                @if (featured is { IsImage: true })
                {
                    <img src="@featured.Url" alt="" />
                }
            </div>
            <button type="button" class="btn" data-pick-featured>Choose image</button>
            <button type="button" class="linklike danger" data-clear-featured hidden="@(featured == null)">Remove</button>
        </section>
    </div>
</form>

@if (Model.Id != 0)
{
    <form id="trash-form" method="post" asp-antiforgery="true" action="/admin/posts/trash/@Model.Id" data-confirm="Move this @noun to the trash?"></form>
}

<partial name="_MediaPicker" />

@section Scripts {
    <script>
        // "Save draft" forces status=Draft regardless of the dropdown.
        document.querySelector('[data-status="Draft"]').addEventListener('click', function () {
            document.getElementById('status-select').value = 'Draft';
        });
    </script>
}
