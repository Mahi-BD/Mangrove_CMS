@{ ViewData["Title"] = "New page"; ViewData["PostType"] = "Page"; }
<div class="page-head">
    <h1>What kind of page?</h1>
    <p class="lede">You can't change the type later, but you can always create another page.</p>
</div>
<div class="kind-grid">
    <a class="kind-card" href="/admin/posts/create?type=Page&kind=Standard">
