@model LoginForm
@{ ViewData["Title"] = "Log in"; }
<h1>Log in</h1>
<p class="lede">Welcome back.</p>
<form method="post" asp-action="Login">
    <div asp-validation-summary="ModelOnly" class="errors"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Login">Username or email</label>
    <input asp-for="Login" autocomplete="username" autofocus />
    <span asp-validation-for="Login" class="field-error"></span>
    <label asp-for="Password">Password</label>
    <input asp-for="Password" autocomplete="current-password" />
    <span asp-validation-for="Password" class="field-error"></span>
    <label class="check" style="margin-top:1rem"><input asp-for="RememberMe" /> Keep me logged in on this device</label>
    <button type="submit" class="btn primary">Log in</button>
</form>
<p class="muted" style="margin-top:1.5rem">New here? <a href="/account/register">Create an account</a>. <a href="/" style="margin-left:.5rem">Back to the site</a></p>
