@model RegisterForm
@{ ViewData["Title"] = "Create an account"; }
<section class="form-page">
    <h1>Create an account</h1>
    <form method="post" asp-action="Register" class="stack">
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <label asp-for="UserName">Username</label>
        <input asp-for="UserName" autocomplete="username" />
        <span asp-validation-for="UserName" class="field-error"></span>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        <button type="submit">Register</button>
    </form>
    <p class="muted">Already have an account? <a href="/account/login">Log in</a></p>
</section>
