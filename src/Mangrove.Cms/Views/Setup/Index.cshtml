@model SetupForm
@{ Layout = "_SetupLayout"; ViewData["Title"] = "Welcome"; }
<h1>Welcome</h1>
<p class="muted">Two minutes and your site is ready. You can change all of this later.</p>
<form method="post" class="stack">
    <div asp-validation-summary="ModelOnly" class="errors"></div>
    <fieldset>
        <legend>Your site</legend>
        <label asp-for="SiteTitle"></label>
        <input asp-for="SiteTitle" />
        <span asp-validation-for="SiteTitle" class="field-error"></span>
        <label asp-for="Tagline"></label>
        <input asp-for="Tagline" />
    </fieldset>
    <fieldset>
        <legend>Administrator account</legend>
        <label asp-for="UserName"></label>
        <input asp-for="UserName" autocomplete="username" />
        <span asp-validation-for="UserName" class="field-error"></span>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </fieldset>
    <label class="check"><input asp-for="SampleContent" /> Add a sample post, page and menu</label>
    <button type="submit" class="btn primary">Install Mangrove CMS</button>
</form>
