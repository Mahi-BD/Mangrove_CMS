@model SetupForm
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Set up your site"; }
<h1>Set up your site</h1>
<p class="lede">Name your site and create the administrator account. You can change everything later.</p>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="errors"></div>
    <fieldset>
        <legend>Your site</legend>
        <label asp-for="SiteTitle">Site name</label>
        <input asp-for="SiteTitle" />
        <span asp-validation-for="SiteTitle" class="field-error"></span>
        <label asp-for="Tagline">Tagline</label>
        <input asp-for="Tagline" />
    </fieldset>
    <fieldset>
        <legend>Administrator</legend>
        <label asp-for="UserName">Username</label>
        <input asp-for="UserName" autocomplete="username" />
        <span asp-validation-for="UserName" class="field-error"></span>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password">Password</label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
        <span class="hint">At least 8 characters.</span>
        <label asp-for="ConfirmPassword">Confirm password</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </fieldset>
    <label class="check"><input asp-for="SampleContent" /> Add a sample post, page and menu to start from</label>
    <button type="submit" class="btn primary">Create my site</button>
</form>
