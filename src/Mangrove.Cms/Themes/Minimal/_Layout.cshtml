@inject SettingsService Settings
@{
    var site = await Settings.AllAsync();
    var siteTitle = site[SettingKeys.SiteTitle];
    var pageTitle = ViewData["Title"] as string;
    var description = ViewData["Description"] as string ?? site[SettingKeys.Tagline];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? siteTitle : $"{pageTitle} – {siteTitle}")</title>
    <meta name="description" content="@description" />
    <meta name="generator" content="Mangrove CMS" />
    @if (ViewData["Canonical"] is string canonical)
    {
        <link rel="canonical" href="@canonical" />
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="@siteTitle" href="/feed" />
    <link rel="stylesheet" href="/themes/mangrove/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="/themes/minimal/style.css" asp-append-version="true" />
</head>
<body class="theme-minimal">
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
        <div class="wrap narrow">
            <a class="site-title" href="/">@siteTitle</a>
            <nav class="site-nav" aria-label="Primary">
                @await Component.InvokeAsync("Menu", new { location = "primary" })
            </nav>
        </div>
    </header>
    <main id="content" class="wrap narrow content">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="wrap narrow">
            @await Component.InvokeAsync("Menu", new { location = "footer" })
            <p>@site[SettingKeys.FooterText] · <a href="/feed">RSS</a> ·
                @if (User.AtLeast(UserRole.Author)) { <a href="/admin">Dashboard</a> } else { <a href="/account/login">Log in</a> }
            </p>
        </div>
    </footer>
</body>
</html>
