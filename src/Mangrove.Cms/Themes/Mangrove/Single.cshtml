@model SingleViewModel
@inject ContentRenderer Renderer
@{
    var post = Model.Post;
    var isHome = ViewData["IsHome"] is true;
    var isPost = post.Type == PostType.Post;
    ViewData["Title"] = isHome ? null : post.Title;
    ViewData["Description"] = post.MetaDescription ?? post.Excerpt ?? Renderer.PlainText(post.Content, 160);
    ViewData["Canonical"] = $"{Context.Request.Scheme}://{Context.Request.Host}/{(isHome ? "" : post.Slug)}";
    ViewData["EditUrl"] = $"/admin/posts/edit/{post.Id}";
    ViewData["EditNoun"] = isPost ? "post" : "page";
    if (post.FeaturedMedia is { IsImage: true } fm) ViewData["OgImage"] = $"{Context.Request.Scheme}://{Context.Request.Host}{fm.Url}";
    var tags = post.PostTerms.Where(pt => pt.Term?.Type == TermType.Tag).Select(pt => pt.Term!).ToList();
    var live = post.IsLive(DateTime.UtcNow);
    var byParent = Model.Comments.ToLookup(c => c.ParentId);
}

<article class="entry entry-@post.Type.ToString().ToLowerInvariant() @(post.Kind != PageKind.Standard && post.Type == PostType.Page ? "entry-wide" : null)">
    @if (!live)
    {
        <p class="notice">This is a preview. The @post.Type.ToString().ToLowerInvariant() is a @post.Status.ToString().ToLowerInvariant() and visitors can't see it yet.</p>
    }
    <header class="entry-head">
        <h1>@post.Title</h1>
        @if (isPost) { <partial name="_PostMeta" model="post" /> }
    </header>

    @if (post.FeaturedMedia is { IsImage: true } img)
    {
        <figure class="entry-figure">
            <img src="@img.Url" alt="@img.AltText" />
            @if (!string.IsNullOrWhiteSpace(img.Caption)) { <figcaption>@img.Caption</figcaption> }
        </figure>
    }

    @if (!string.IsNullOrWhiteSpace(post.Content))
    {
        <div class="entry-content">
            @Model.Body
        </div>
    }

    @if (Model.Table != null) { <partial name="_PageTable" model="Model.Table" /> }
    @if (Model.Notices != null) { <partial name="_NoticeList" model="Model.Notices" /> }

    @if (tags.Count > 0)
    {
        <ul class="tags" aria-label="Tags">
            @foreach (var t in tags) { <li><a href="/tag/@t.Slug" rel="tag">@t.Name</a></li> }
        </ul>
    }

    @if (isPost && post.Author != null && !string.IsNullOrWhiteSpace(post.Author.Bio))
    {
        <aside class="byline-card">
            <span class="byline-avatar" aria-hidden="true">@Fmt.Name(post.Author)[..1]</span>
            <div>
                <a href="/author/@post.Author.UserName" class="byline-name">@Fmt.Name(post.Author)</a>
                <p>@post.Author.Bio</p>
            </div>
        </aside>
    }
</article>

@if (isPost && (Model.Previous != null || Model.Next != null))
{
    <nav class="post-nav" aria-label="Other posts">
        @if (Model.Previous != null) { <a href="/@Model.Previous.Slug" rel="prev"><small>Previous post</small>@Model.Previous.Title</a> } else { <span></span> }
        @if (Model.Next != null) { <a href="/@Model.Next.Slug" rel="next" class="next"><small>Next post</small>@Model.Next.Title</a> }
    </nav>
}

@if (isPost && (Model.Comments.Count > 0 || Model.CommentsOpen || !string.IsNullOrEmpty(Model.Flash)))
{
    <section id="comments" class="comments">
        @if (!string.IsNullOrEmpty(Model.Flash)) { <p class="notice" role="status">@Model.Flash</p> }

        <h2>@(Model.Comments.Count == 0 ? "Comments" : Model.Comments.Count == 1 ? "1 comment" : $"{Model.Comments.Count} comments")</h2>
        @if (Model.Comments.Count > 0)
        {
            <ol class="comment-list">
                @foreach (var c in byParent[null]) { RenderComment(c, 0); }
            </ol>
        }

        @if (Model.CommentsOpen)
        {
            <div id="respond" class="respond">
                <h3>@(Model.Comments.Count == 0 ? "Start the conversation" : "Add a comment")</h3>
                <form method="post" asp-antiforgery="true" action="/comments" class="comment-form">
                    <input type="hidden" asp-for="CommentForm.PostId" name="PostId" />
                    <input type="hidden" name="ParentId" id="comment-parent" value="" />
                    <p id="replying-to" class="replying" hidden>Replying to <strong></strong>. <button type="button" class="linklike" data-cancel-reply>Cancel reply</button></p>
                    <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="Website2" tabindex="-1" autocomplete="off" /></label></div>
                    <label for="c-body">Comment</label>
                    <textarea id="c-body" name="Content" rows="5" required maxlength="5000"></textarea>
                    <div class="row">
                        <div><label for="c-name">Name</label><input id="c-name" name="AuthorName" value="@Model.CommentForm.AuthorName" required maxlength="120" autocomplete="name" /></div>
                        <div><label for="c-email">Email <small>(never shown)</small></label><input id="c-email" type="email" name="AuthorEmail" value="@Model.CommentForm.AuthorEmail" maxlength="200" autocomplete="email" /></div>
                    </div>
                    <label for="c-url">Website <small>(optional)</small></label>
                    <input id="c-url" type="url" name="AuthorUrl" maxlength="300" placeholder="https://" autocomplete="url" />
                    <button type="submit" class="button">Post comment</button>
                </form>
            </div>
            <script>
                document.addEventListener('click', function (e) {
                    var reply = e.target.closest('[data-reply]'), cancel = e.target.closest('[data-cancel-reply]');
                    var box = document.getElementById('replying-to');
                    if (reply) {
                        document.getElementById('comment-parent').value = reply.dataset.reply;
                        box.querySelector('strong').textContent = reply.dataset.name;
                        box.hidden = false;
                        document.getElementById('c-body').focus();
                    } else if (cancel) {
                        document.getElementById('comment-parent').value = '';
                        box.hidden = true;
                    }
                });
            </script>
        }
        else
        {
            <p class="muted">Comments are closed.</p>
        }
    </section>
}

@functions {
    void RenderComment(Comment c, int depth)
    {
        var children = Model.Comments.Where(x => x.ParentId == c.Id).ToList();
        var safeUrl = c.AuthorUrl != null && (c.AuthorUrl.StartsWith("https://") || c.AuthorUrl.StartsWith("http://")) ? c.AuthorUrl : null;
        <li class="comment" id="comment-@c.Id">
            <div class="comment-meta">
                <strong>
                    @if (safeUrl != null)
                    {
                        <a href="@safeUrl" rel="nofollow ugc noopener">@c.AuthorName</a>
                    }
                    else
                    {
                        @c.AuthorName
                    }
                </strong>
                <time datetime="@c.CreatedAt.ToString("O")" title="@c.CreatedAt.ToString("d MMMM yyyy, HH:mm") UTC">@Fmt.Ago(c.CreatedAt)</time>
            </div>
            <div class="comment-body">@Renderer.RenderComment(c.Content)</div>
            @if (Model.CommentsOpen && depth < 3)
            {
                <button type="button" class="linklike reply" data-reply="@c.Id" data-name="@c.AuthorName">Reply</button>
            }
            @if (children.Count > 0)
            {
                <ol class="children">
                    @foreach (var ch in children)
                    {
                        RenderComment(ch, depth + 1);
                    }
                </ol>
            }
        </li>
    }
}
