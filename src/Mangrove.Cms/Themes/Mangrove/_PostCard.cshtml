@model Post
@inject ContentRenderer Renderer
@{
    var excerpt = string.IsNullOrWhiteSpace(Model.Excerpt) ? Renderer.PlainText(Model.Content, 240) : Model.Excerpt;
    var category = Model.PostTerms.FirstOrDefault(pt => pt.Term?.Type == TermType.Category)?.Term;
}
<article class="entry-row">
    <time class="row-date" datetime="@Model.PublishedAt?.ToString("O")">@Model.PublishedAt?.ToString("d MMM yyyy")</time>
    <div class="row-body">
        <h2 class="row-title"><a href="/@Model.Slug">@Model.Title</a></h2>
        <p class="row-excerpt">@excerpt</p>
        <p class="row-meta">
            @if (Model.IsSticky) { <span class="pinned">Pinned</span> }
            @if (category != null) { <a href="/category/@category.Slug">@category.Name</a> }
            @if (Model.Author != null) { <span>by @Fmt.Name(Model.Author)</span> }
        </p>
    </div>
    @if (Model.FeaturedMedia is { IsImage: true } img)
    {
        <a class="row-thumb" href="/@Model.Slug" tabindex="-1" aria-hidden="true"><img src="@img.Url" alt="" loading="lazy" /></a>
    }
</article>
