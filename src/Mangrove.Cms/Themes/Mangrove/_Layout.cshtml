@inject SettingsService Settings
@{
    var site = await Settings.AllAsync();
    var siteTitle = site[SettingKeys.SiteTitle];
    var tagline = site[SettingKeys.Tagline];
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(pageTitle) ? (string.IsNullOrEmpty(tagline) ? siteTitle : $"{siteTitle}: {tagline}") : $"{pageTitle} | {siteTitle}";
    var description = ViewData["Description"] as string ?? tagline;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta name="generator" content="Mangrove CMS" />
    <meta property="og:site_name" content="@siteTitle" />
    <meta property="og:title" content="@(pageTitle ?? siteTitle)" />
    <meta property="og:description" content="@description" />
    @if (ViewData["OgImage"] is string og) { <meta property="og:image" content="@og" /> }
    @if (ViewData["Canonical"] is string canonical) { <link rel="canonical" href="@canonical" /> }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="@siteTitle" href="/feed" />
    <link rel="preload" href="/fonts/literata-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/themes/mangrove/style.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    @if (User.AtLeast(UserRole.Author))
    {
        <div class="admin-strip">
            <div class="wrap">
                <a href="/admin">Dashboard</a>
                <a href="/admin/posts/create">New post</a>
                @if (ViewData["EditUrl"] is string edit) { <a href="@edit">Edit this @(ViewData["EditNoun"] ?? "page")</a> }
                <form method="post" asp-antiforgery="true" action="/account/logout" class="inline"><button type="submit" class="linklike">Log out</button></form>
            </div>
        </div>
    }
    <header class="masthead">
        <div class="wrap masthead-inner">
            <div class="branding">
                <a class="site-title" href="/">@siteTitle</a>
                @if (!string.IsNullOrEmpty(tagline)) { <p class="site-tagline">@tagline</p> }
            </div>
            <nav class="site-nav" aria-label="Main">
                @await Component.InvokeAsync("Menu", new { location = "primary" })
                <form action="/search" method="get" role="search" class="nav-search">
                    <label for="nav-q" class="sr-only">Search this site</label>
                    <input id="nav-q" type="search" name="q" placeholder="Search" value="@Context.Request.Query["q"]" />
                </form>
            </nav>
        </div>
        <div class="rootline"><partial name="_Roots" /></div>
    </header>

    <main id="content" class="wrap site-main">
        @RenderBody()
    </main>

    <partial name="_Footer" />
</body>
</html>
