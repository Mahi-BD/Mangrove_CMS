@{ ViewData["Title"] = "Page not found"; }
<section class="notfound">
    <h1>Page not found</h1>
    <p>Sorry, nothing lives at this address. Maybe a search helps?</p>
    <form action="/search" method="get" role="search" class="search-form big">
        <label for="q404" class="sr-only">Search</label>
        <input id="q404" type="search" name="q" placeholder="Search posts…" />
        <button type="submit">Search</button>
    </form>
    <p><a href="/">← Back to the homepage</a></p>
</section>
