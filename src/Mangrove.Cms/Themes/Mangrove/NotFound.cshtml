@{ ViewData["Title"] = "Page not found"; }
<section class="archive-head notfound">
    <h1>This page has drifted off</h1>
    <p>There's nothing at this address. It may have moved, or the link may be mistyped. Try searching instead.</p>
    <form action="/search" method="get" role="search" class="search-big">
        <label for="q404" class="sr-only">Search</label>
        <input id="q404" type="search" name="q" placeholder="Search posts" />
        <button type="submit" class="button">Search</button>
    </form>
    <p><a href="/">Go to the home page</a></p>
</section>
