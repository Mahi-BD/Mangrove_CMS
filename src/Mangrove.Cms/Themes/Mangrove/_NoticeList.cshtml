@model NoticeListView
@{
    var path = Context.Request.Path.Value ?? "/";
    var slug = path.TrimEnd('/').Split('/').Last();
    string PageUrl(int n) => $"{path}?page={n}{(string.IsNullOrEmpty(Model.Query) ? "" : "&q=" + Uri.EscapeDataString(Model.Query))}#notices";
    var r = Model.Result;
}
<section class="notices" id="notices" aria-label="Notices">
    @if (Model.Searchable && (r.Total > 0 || Model.Query != null))
    {
        <form method="get" action="@path#notices" role="search" class="data-search">
            <label for="notice-q" class="sr-only">Search notices</label>
            <input id="notice-q" type="search" name="q" value="@Model.Query" placeholder="Search notices" />
            <button type="submit" class="button">Search</button>
            @if (!string.IsNullOrEmpty(Model.Query)) { <a href="@path#notices" class="clear">Show all</a> }
        </form>
    }

    @if (r.Total == 0)
    {
        <p class="empty">@(Model.Query != null ? $"No notices match “{Model.Query}”." : "There are no notices yet.")</p>
    }
    else
    {
        <ol class="notice-list">
            @foreach (var n in r.Items)
            {
                var url = $"/{slug}/notice/{n.Id}";
                <li class="notice-item @(n.IsPinned ? "pinned" : null)">
                    <time class="notice-date" datetime="@n.NoticeDate.ToString("yyyy-MM-dd")"><b>@n.NoticeDate.Day</b>@n.NoticeDate.ToString("MMM yyyy")</time>
                    <div class="notice-body">
                        @if (n.IsPinned) { <span class="pinned-label">Pinned</span> }
                        <h2 class="notice-title"><a href="@url">@n.Title</a></h2>
                        @if (n.Attachments.Count > 0)
                        {
                            <ul class="file-chips" aria-label="Files">
                                @foreach (var a in n.Attachments.OrderBy(a => a.SortOrder).Where(a => a.Media != null))
                                {
                                    <li><a href="@a.Media!.Url" target="_blank" rel="noopener" download="@(a.Media.ContentType == "application/pdf" ? null : a.Media.FileName)">
                                        <span class="ext">@System.IO.Path.GetExtension(a.Media.FileName).TrimStart('.').ToUpperInvariant()</span> @a.Media.FileName</a></li>
                                }
                            </ul>
                        }
                    </div>
                    <a class="button ghost notice-more" href="@url">Details<span class="sr-only">: @n.Title</span></a>
                </li>
            }
        </ol>
        @if (r.TotalPages > 1)
        {
            <nav class="pager" aria-label="More notices">
                @if (r.HasPrevious) { <a class="button ghost" href="@PageUrl(r.Page - 1)">Newer notices</a> } else { <span></span> }
                <span class="pager-count">Page @r.Page of @r.TotalPages</span>
                @if (r.HasNext) { <a class="button ghost" href="@PageUrl(r.Page + 1)">Older notices</a> } else { <span></span> }
            </nav>
        }
    }
</section>
